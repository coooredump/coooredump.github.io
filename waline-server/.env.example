# ---------------------------------------------------------------------------
# Waline server environment variables
#
# This file is a reference only. Set these variables in the Vercel project
# (Settings -> Environment Variables), never commit real credentials.
# ---------------------------------------------------------------------------

# --- LeanCloud (reuse the same app as the old Waline project) ---------------
LEAN_ID=
LEAN_KEY=
LEAN_MASTER_KEY=
# Only needed for some LeanCloud international/self-hosted setups:
# LEAN_SERVER=

# --- Site ------------------------------------------------------------------
SITE_NAME=Core's ink
SITE_URL=https://wu-yikun.com/

# Receives new-comment notifications; also used to skip the author's own
# comments. Change it to the inbox you actually read.
AUTHOR_EMAIL=wuyikun@stu.xmu.edu.cn

# Optional: restrict which origins may post comments.
# SECURE_DOMAINS=wu-yikun.com,coooredump.github.io

# Optional: set to true to disable only the admin/new-comment email.
# DISABLE_AUTHOR_NOTIFY=false

# --- QQ Mail SMTP ----------------------------------------------------------
SMTP_SERVICE=QQ
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SENDER_NAME=Core's ink
# Must match SMTP_USER for QQ Mail.
SENDER_EMAIL=

# Optional subject/template overrides; see COMMENTS.md in the repository root.
# MAIL_SUBJECT_ADMIN=[Core's ink] 新评论
# MAIL_TEMPLATE_ADMIN=
# MAIL_SUBJECT=[Core's ink] 你的评论收到了回复
# MAIL_TEMPLATE=
