---
import type { MarkdownHeading } from 'astro'

import { TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import Giscus from '@/components/comments/Giscus.astro'
import SearchMetadata from '@/components/search/SearchMetadata.astro'

interface Props {
  title: string
  headings?: MarkdownHeading[]
  view?: boolean
  comment?: boolean
}

const { title, headings, view, comment: enableComment, ...props } = Astro.props
// Giscus doesn't expose a pageview counter. Keep the prop for existing page
// frontmatter while rendering only the comment section.
void view
---

<PageLayout meta={{ title }} {...props}>
  {headings?.length && <TOC headings={headings} slot='sidebar' />}

  <Fragment slot='header'>
    <SearchMetadata title={title} />
    <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl'>{title}</h1>
  </Fragment>

  <slot />

  <slot name='bottom' slot='bottom'>
    {enableComment && <Giscus class='mt-3 sm:mt-6' />}
  </slot>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>
